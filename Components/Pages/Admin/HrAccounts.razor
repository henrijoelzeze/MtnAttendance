@page "/admin/hr-accounts"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer
@inject HrAuthService Auth
@inject AuthenticationStateProvider AuthState

<PageTitle>HR Directory Access</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>HR Directory Access</h1>
            <p>Only the corporate directory determines HR sign-in eligibility. Entries below are local records of HR sign-ins, not an access-control list.
               Passwords cannot be reset from this application.</p>
        </div>
    </div>

    <div class="table-card">
        <table>
            <thead>
                <tr><th>Name</th><th>Person number</th><th>HR access</th><th>Last login</th></tr>
            </thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr>
                        <td>@account.FullName</td><td>@account.PersonNumber</td>
                        <td>
                            @if (account.IsEnabled)
                            {
                                <span class="pill active">Local account enabled</span>
                            }
                            else
                            {
                                <span class="pill disabled">Disabled</span>
                            }
                        </td>
                        <td>
                            @Ui.LastLogin(account.LastLoginAt, DateTime.Now)
                            @if (account.EmployeeId == _currentEmployeeId)
                            {
                                <span> (current user)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_accounts.Count == 0)
        {
            <p class="empty">No locally provisioned HR accounts yet. Authorized HR staff are added after their first corporate directory sign-in.</p>
        }
    </div>
</div>

@code {
    private List<HrColleague> _accounts = [];
    private int _currentEmployeeId;
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentEmployeeId = state.User.EmployeeId();
        _accounts = await Auth.GetHrAccountsAsync();
    }
}