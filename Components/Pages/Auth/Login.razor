@page "/admin/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@inject HrAuthService Auth
@inject NavigationManager Nav

<PageTitle>HR directory sign in</PageTitle>

<div class="mobile-card">
    <h1>MTN CIV Attendance</h1>
    <p class="sub">Human Resources — corporate directory sign-in</p>
    <div class="rule"></div>

    @if (_error is not null)
    {
        <p class="form-error" role="alert">@_error</p>
    }

    <EditForm Model="Input" FormName="hr-ldaps-login" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <label class="field">
            <span>Person Number</span>
            <InputText @bind-Value="Input.PersonNumber" autocomplete="username"
                       inputmode="numeric" autofocus placeholder="Enter your employee number" />
        </label>
        <ValidationMessage For="() => Input.PersonNumber" />
        <label class="field">
            <span>Corporate directory password</span>
            <InputText @bind-Value="Input.Password" type="password"
                       autocomplete="current-password" />
        </label>
        <ValidationMessage For="() => Input.Password" />
        <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </EditForm>
</div>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;
    private string? _error;

    protected override void OnInitialized() => Input ??= new LoginInput();

    private async Task SubmitAsync()
    {
        _error = null;
        var result = await Auth.AuthenticateAsync(Input.PersonNumber, Input.Password,
            HttpContext.RequestAborted);
        Input.Password = string.Empty;

        if (result.Status != HrSignInStatus.Success || result.Identity is null)
        {
            _error = result.Status == HrSignInStatus.DirectoryUnavailable
                ? "Corporate directory sign-in is temporarily unavailable. Contact IT support."
                : "Unable to sign in. Verify your credentials and HR access.";
            return;
        }

        await HttpContext.SignInAsync(HrAuth.Scheme,
            HrAuthService.BuildPrincipal(result.Identity),
            new AuthenticationProperties { IsPersistent = false });
        Nav.NavigateTo("/admin/events");
    }

    public sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your Person Number.")]
        public string PersonNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your corporate password.")]
        public string Password { get; set; } = string.Empty;
    }
}